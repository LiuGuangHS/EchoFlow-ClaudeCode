{
  "exclude": [
    "adapters",
    "artifacts",
    "desktop",
    "mobile",
    "site",
    "node_modules"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ant/claude-for-chrome-mcp": [
        "./stubs/ant-claude-for-chrome-mcp.ts"
      ],
      "color-diff-napi": [
        "./stubs/color-diff-napi.ts"
      ],
      "src/*": [
        "./src/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  }
}
